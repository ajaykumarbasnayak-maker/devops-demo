
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Source code is available from GitHub'
            }
        }

        stage('Build') {
            steps {
                echo 'Build stage running'
            }
        }

        stage('Test') {
            steps {
                echo 'Test stage running'
            }
        }

        
        stage('package') {
            steps {
                echo 'package running'
            }
        }
        
        stage('Deploy') {
            steps {
                echo 'deployed to folder'
            }
        }


    }
}
